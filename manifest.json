{
  "manifest_version": 3,
  "name": "Kick RTL Chat Fix",
  "version": "1.0.0",
  "description": "Fixes Persian, Arabic, mixed-language, and emoji bidi rendering in Kick chat.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "تنظیمات راست‌چین Kick",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://kick.com/*", "https://www.kick.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
